---
interface Props {
  mode: 'login' | 'register';
}

const { mode } = Astro.props;
const isRegister = mode === 'register';
---

<form class="auth-form" data-auth-form data-mode={mode} novalidate>
  {
    isRegister && (
      <label>
        Username
        <input
          name="username"
          type="text"
          autocomplete="username"
          autocapitalize="none"
          spellcheck="false"
          minlength="3"
          maxlength="30"
          pattern="[A-Za-z0-9._]+"
          required
        />
      </label>
    )
  }
  <label>
    {isRegister ? 'Email' : 'Email atau username'}
    <input
      name={isRegister ? 'email' : 'identifier'}
      type={isRegister ? 'email' : 'text'}
      autocomplete={isRegister ? 'email' : 'username'}
      autocapitalize="none"
      spellcheck="false"
      maxlength="254"
      required
    />
  </label>
  <label>
    Kata sandi
    <input
      name="password"
      type="password"
      autocomplete={isRegister ? 'new-password' : 'current-password'}
      minlength={isRegister ? 8 : undefined}
      maxlength="72"
      aria-describedby={isRegister ? 'password-help' : undefined}
      required
    />
  </label>
  {
    isRegister && (
      <p id="password-help" class="field-help">
        Minimal 8 karakter, kombinasi huruf dan angka. Kata sandi tidak pernah
        ditampilkan kembali.
      </p>
    )
  }
  <p class="form-status" data-form-status role="status" aria-live="polite"></p>
  <button class="button" type="submit">
    {isRegister ? 'Buat Akun' : 'Masuk'}
  </button>
</form>

<div class="toast-region" role="status" aria-live="polite" data-toast-region>
</div>
<template data-toast-template>
  <div class="toast">
    <span class="toast-icon" aria-hidden="true">✓</span>
    <span class="toast-text" data-toast-text></span>
    <button
      type="button"
      class="toast-close"
      data-toast-close
      aria-label="Tutup pemberitahuan">×</button
    >
  </div>
</template>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-auth-form]');

  // Registering ends on the login page, so the form that registers leaves a
  // one-shot flag and the login form shows the toast. Only a known key is
  // stored, never text.
  const TOAST_KEY = 'adicara:toast';
  const TOASTS: Record<string, string> = {
    registered: 'Akun berhasil dibuat. Silakan masuk.',
  };
  const TOAST_MS = 6000;

  function showPendingToast() {
    let message: string | undefined;
    try {
      message = TOASTS[sessionStorage.getItem(TOAST_KEY) ?? ''];
      sessionStorage.removeItem(TOAST_KEY);
    } catch {
      return; // storage unavailable: skip the toast, the page still works
    }

    const region = document.querySelector('[data-toast-region]');
    const template = document.querySelector<HTMLTemplateElement>(
      '[data-toast-template]',
    );
    const toast = template?.content.firstElementChild?.cloneNode(true);
    if (!message || !region || !(toast instanceof HTMLElement)) return;

    const text = toast.querySelector('[data-toast-text]');
    if (text) text.textContent = message;
    const dismiss = () => toast.remove();
    toast
      .querySelector('[data-toast-close]')
      ?.addEventListener('click', dismiss);
    region.append(toast);
    window.setTimeout(dismiss, TOAST_MS);
  }

  if (form?.dataset.mode === 'login') showPendingToast();

  if (form) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const button = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      );
      if (!status || !button || !form.reportValidity()) return;

      const mode = form.dataset.mode === 'register' ? 'register' : 'login';
      const values = Object.fromEntries(new FormData(form)) as Record<
        string,
        string
      >;
      // The backend stores usernames in lowercase and matches emails case-insensitively.
      for (const key of ['username', 'email', 'identifier']) {
        if (values[key]) values[key] = values[key].trim();
      }
      if (values.username) values.username = values.username.toLowerCase();

      status.textContent = 'Memeriksa data…';
      button.disabled = true;
      let navigating = false;

      try {
        // Same-origin endpoint that talks to the API and sets the session cookies.
        const response = await fetch(`/auth/${mode}`, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(values),
        });
        const payload = await response.json().catch(() => null);
        if (!response.ok) {
          status.textContent =
            payload?.error?.message ??
            'Permintaan belum berhasil. Periksa kembali data Anda.';
          return;
        }
        if (mode === 'register') {
          try {
            sessionStorage.setItem(TOAST_KEY, 'registered');
          } catch {
            // storage unavailable: the redirect still happens, without a toast
          }
        }
        const target = payload?.redirect;
        navigating = true;
        window.location.assign(
          typeof target === 'string' &&
            target.startsWith('/') &&
            !target.startsWith('//')
            ? target
            : '/dashboard',
        );
      } catch {
        status.textContent =
          'Layanan belum dapat dijangkau. Silakan coba kembali.';
      } finally {
        if (!navigating) button.disabled = false;
      }
    });
  }
</script>

<style>
  .auth-form {
    display: grid;
    gap: var(--space-4);
  }
  label {
    display: grid;
    gap: var(--space-2);
    font-size: 0.85rem;
    font-weight: 700;
  }
  input {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-text);
  }
  input:focus {
    border-color: var(--color-accent);
  }
  .field-help,
  .form-status {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }
  .form-status:not(:empty) {
    padding: var(--space-3);
    border-left: 2px solid var(--color-accent);
    background: var(--color-surface-muted);
  }
  .button {
    margin-top: var(--space-2);
    cursor: pointer;
  }
  .button:disabled {
    cursor: wait;
    opacity: 0.65;
  }
  .toast-region {
    position: fixed;
    /* Below the sticky site header (min-height 4.25rem), so the toast never
       covers the logo, the menu button, or the navigation. */
    inset: calc(4.25rem + var(--space-3)) var(--space-4) auto;
    z-index: 100;
    display: grid;
    justify-items: center;
    pointer-events: none;
  }
  .toast {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    max-width: 28rem;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 600;
    pointer-events: auto;
    animation: toast-in 0.25s ease-out;
  }
  .toast-icon {
    color: var(--color-accent-deep);
    font-weight: 800;
  }
  .toast-close {
    min-width: 2rem;
    min-height: 2rem;
    margin-left: auto;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-muted);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }
  .toast-close:hover {
    color: var(--color-text);
  }
  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .toast {
      animation: none;
    }
  }
</style>

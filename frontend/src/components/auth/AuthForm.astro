---
interface Props {
  mode: 'login' | 'register';
}

const { mode } = Astro.props;
const isRegister = mode === 'register';
---

<form class="auth-form" data-auth-form data-mode={mode} novalidate>
  {
    isRegister && (
      <label>
        Nama
        <input
          name="display_name"
          type="text"
          autocomplete="name"
          minlength="2"
          maxlength="100"
          required
        />
      </label>
    )
  }
  <label>
    Email
    <input
      name="email"
      type="email"
      autocomplete="email"
      maxlength="254"
      required
    />
  </label>
  <label>
    Kata sandi
    <input
      name="password"
      type="password"
      autocomplete={isRegister ? 'new-password' : 'current-password'}
      minlength={isRegister ? 12 : undefined}
      maxlength="128"
      aria-describedby={isRegister ? 'password-help' : undefined}
      required
    />
  </label>
  {
    isRegister && (
      <p id="password-help" class="field-help">
        Gunakan setidaknya 12 karakter. Kata sandi tidak pernah ditampilkan
        kembali.
      </p>
    )
  }
  <p class="form-status" data-form-status role="status" aria-live="polite"></p>
  <button class="button" type="submit">
    {isRegister ? 'Buat Akun' : 'Masuk'}
  </button>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-auth-form]');

  if (form) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const button = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      );
      if (!status || !button || !form.reportValidity()) return;

      const mode = form.dataset.mode;
      const values = Object.fromEntries(new FormData(form));
      status.textContent = 'Memeriksa data…';
      button.disabled = true;

      try {
        const response = await fetch(
          `/api/v1/auth/${mode === 'register' ? 'register' : 'login'}`,
          {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(values),
          },
        );
        const payload = await response.json();
        if (!response.ok) {
          status.textContent =
            payload?.error?.message ??
            'Permintaan belum berhasil. Periksa kembali data Anda.';
          return;
        }
        window.location.assign('/dashboard');
      } catch {
        status.textContent =
          'Layanan belum dapat dijangkau. Silakan coba kembali.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .auth-form {
    display: grid;
    gap: var(--space-4);
  }
  label {
    display: grid;
    gap: var(--space-2);
    font-size: 0.85rem;
    font-weight: 700;
  }
  input {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-text);
  }
  input:focus {
    border-color: var(--color-accent);
  }
  .field-help,
  .form-status {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }
  .form-status:not(:empty) {
    padding: var(--space-3);
    border-left: 2px solid var(--color-accent);
    background: var(--color-surface-muted);
  }
  .button {
    margin-top: var(--space-2);
    cursor: pointer;
  }
  .button:disabled {
    cursor: wait;
    opacity: 0.65;
  }
</style>

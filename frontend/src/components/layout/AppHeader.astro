<header class="app-header">
  <div class="container app-header__inner">
    <a class="wordmark" href="/dashboard">Adicara</a>
    <nav aria-label="Navigasi dashboard">
      <a href="/dashboard">Undangan</a>
      <button type="button" data-logout>Keluar</button>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-logout]');

  button?.addEventListener('click', async () => {
    button.disabled = true;
    try {
      // JSON on purpose: a body-less POST is treated by Astro as a form post and
      // origin-checked, which fails behind a TLS-terminating proxy.
      const response = await fetch('/auth/logout', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: '{}',
      });
      if (response.ok) {
        window.location.assign('/auth/masuk');
        return;
      }
    } catch {
      // Unreachable server: stay signed in and let the user try again.
    }
    button.disabled = false;
  });
</script>

<style>
  .app-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .app-header__inner,
  nav {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 1.65rem;
    text-decoration: none;
  }
  nav {
    min-height: auto;
  }
  nav a,
  nav button {
    color: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }
  nav button {
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
</style>

---
import AppLayout from '@/layouts/AppLayout.astro';
---

<AppLayout
  title="Buat Undangan — Adicara"
  description="Buat draft undangan digital Adicara."
>
  <section class="editor-hero">
    <div class="editor-container">
      <a href="/dashboard">← Kembali ke dashboard</a>
      <p class="eyebrow">Undangan baru</p>
      <h1>Mulai dari informasi yang paling penting.</h1>
      <p>
        Form terstruktur ini membuat draft; kalian dapat menerbitkannya dari
        dashboard.
      </p>
    </div>
  </section>

  <section class="editor-container editor-section">
    <form data-invitation-form>
      <fieldset>
        <legend>Dasar acara</legend>
        <label
          >Judul undangan <input
            name="title"
            required
            minlength="3"
            maxlength="160"
            placeholder="Pernikahan Nara & Arka"
          /></label
        >
        <label
          >Slug publik <input
            name="slug"
            required
            minlength="3"
            maxlength="100"
            pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
            placeholder="nara-dan-arka"
          /></label
        >
        <label
          >Jenis acara <input
            name="event_type"
            required
            value="wedding"
            pattern="[a-z][a-z0-9-]+"
          /></label
        >
        <label>
          Tema
          <select name="template_key" required>
            <option value="editorial-ivory">Editorial Ivory</option>
            <option value="botanical-modern">Botanical Modern</option>
            <option value="monochrome-luxe">Monochrome Luxe</option>
            <option value="batak-senja">Batak Senja — Pernikahan</option>
          </select>
        </label>
      </fieldset>

      <fieldset>
        <legend>Mempelai</legend>
        <div class="two-columns">
          <label
            >Nama pertama <input
              name="host_one_name"
              required
              maxlength="120"
            /></label
          >
          <label
            >Peran <input
              name="host_one_role"
              required
              maxlength="120"
              value="Mempelai wanita"
            /></label
          >
          <label
            >Nama kedua <input
              name="host_two_name"
              required
              maxlength="120"
            /></label
          >
          <label
            >Peran <input
              name="host_two_role"
              required
              maxlength="120"
              value="Mempelai pria"
            /></label
          >
        </div>
      </fieldset>

      <fieldset>
        <legend>Acara pertama</legend>
        <label
          >Nama acara <input
            name="event_name"
            required
            maxlength="120"
            value="Akad nikah"
          /></label
        >
        <label
          >Mulai (WIB) <input
            name="start_at"
            type="datetime-local"
            required
          /></label
        >
        <label
          >Berakhir (opsional, WIB) <input
            name="end_at"
            type="datetime-local"
          /></label
        >
        <label
          >Nama tempat <input
            name="venue_name"
            required
            maxlength="160"
          /></label
        >
        <label
          >Alamat <textarea
            name="venue_address"
            required
            maxlength="500"
            rows="3"></textarea></label
        >
        <label
          >Tautan peta (opsional) <input
            name="map_url"
            type="url"
            placeholder="https://maps.google.com/…"
          /></label
        >
      </fieldset>

      <fieldset data-batak-fields hidden disabled>
        <legend>Acara kedua — Resepsi dan Adat</legend>
        <p>
          Batak Senja menampilkan dua halaman acara. Isi keduanya agar jadwal
          dan peta berbeda.
        </p>
        <label
          >Nama acara <input
            name="event_two_name"
            value="Resepsi dan Adat"
            required
            maxlength="120"
          /></label
        >
        <div class="two-columns">
          <label
            >Mulai (WIB) <input
              name="event_two_start_at"
              type="datetime-local"
              required
            /></label
          >
          <label
            >Berakhir (opsional, WIB) <input
              name="event_two_end_at"
              type="datetime-local"
            /></label
          >
        </div>
        <label
          >Nama tempat <input
            name="event_two_venue_name"
            required
            maxlength="160"
          /></label
        >
        <label
          >Alamat <textarea
            name="event_two_venue_address"
            required
            maxlength="500"
            rows="3"></textarea></label
        >
        <label
          >Tautan peta (opsional) <input
            name="event_two_map_url"
            type="url"
            placeholder="https://maps.google.com/…"
          /></label
        >
      </fieldset>

      <fieldset data-batak-fields hidden disabled>
        <legend>Foto undangan</legend>
        <p>
          JPEG, PNG, atau WebP; maksimal 5 MB per foto. Unggah dua potret dan
          hingga lima foto galeri. Foto tersimpan di database dan tampil saat
          undangan diterbitkan.
        </p>
        <div class="two-columns">
          <label
            >Potret mempelai pertama <input
              name="bride_photo"
              type="file"
              accept="image/jpeg,image/png,image/webp"
            /></label
          >
          <label
            >Potret mempelai kedua <input
              name="groom_photo"
              type="file"
              accept="image/jpeg,image/png,image/webp"
            /></label
          >
        </div>
        <label
          >Galeri (maksimal 5 foto) <input
            name="gallery_photos"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            multiple
          /></label
        >
      </fieldset>

      <fieldset data-batak-fields hidden disabled>
        <legend>Teks dan identitas Batak Senja</legend>
        <p>Kolom yang dibiarkan kosong menggunakan teks bawaan template.</p>
        <div class="two-columns">
          <label
            >Orang tua mempelai pertama <input
              name="bride_parents"
              maxlength="240"
              placeholder="Putri dari Bapak ... dan Ibu ..."
            /></label
          >
          <label
            >Orang tua mempelai kedua <input
              name="groom_parents"
              maxlength="240"
              placeholder="Putra dari Bapak ... dan Ibu ..."
            /></label
          >
          <label
            >Instagram mempelai pertama <input
              name="bride_instagram"
              maxlength="80"
              pattern="@?[A-Za-z0-9._]+"
              placeholder="namaakun"
            /></label
          >
          <label
            >Instagram mempelai kedua <input
              name="groom_instagram"
              maxlength="80"
              pattern="@?[A-Za-z0-9._]+"
              placeholder="namaakun"
            /></label
          >
        </div>
        <label
          >Judul opening <input
            name="opening_heading"
            maxlength="120"
            placeholder="By the Grace of the Lord"
          /></label
        >
        <label
          >Pengantar opening <textarea
            name="opening_text"
            maxlength="1000"
            rows="3"></textarea></label
        >
        <label
          >Salam <textarea name="greeting_text" maxlength="1000" rows="3"
          ></textarea></label
        >
        <label
          >Kutipan <textarea name="quote_text" maxlength="1000" rows="3"
          ></textarea></label
        >
        <label
          >Sumber kutipan <input
            name="quote_source"
            maxlength="120"
            placeholder="Matius 19:6"
          /></label
        >
        <label
          >Catatan pasangan <input
            name="couple_note"
            maxlength="240"
            placeholder="Dua hati, satu perjalanan baru."
          /></label
        >
        <label
          >Pengantar RSVP <textarea name="rsvp_text" maxlength="500" rows="2"
          ></textarea></label
        >
        <label
          >Judul doa <input
            name="prayer_title"
            maxlength="120"
            placeholder="Doa untuk Pengantin"
          /></label
        >
        <label
          >Isi doa <textarea name="prayer_text" maxlength="1000" rows="3"
          ></textarea></label
        >
        <label
          >Sumber doa <input
            name="prayer_source"
            maxlength="120"
            placeholder="Efesus 4:32"
          /></label
        >
        <label
          >Pesan hadiah <textarea name="gift_text" maxlength="1000" rows="3"
          ></textarea></label
        >
        <div class="two-columns">
          <label
            >Bank / dompet digital <input
              name="gift_bank"
              maxlength="120"
            /></label
          >
          <label
            >Nomor rekening <input
              name="gift_account_number"
              maxlength="80"
            /></label
          >
        </div>
        <label
          >Nama pemilik rekening <input
            name="gift_account_name"
            maxlength="120"
          /></label
        >
        <label
          >Pesan penutup <textarea name="closing_text" maxlength="1000" rows="3"
          ></textarea></label
        >
        <label
          >URL musik (opsional, file audio HTTPS) <input
            name="music_url"
            type="url"
            maxlength="1000"
            pattern="https://.+"
            placeholder="https://contoh.com/musik.mp3"
          /></label
        >
      </fieldset>

      <label class="checkbox"
        ><input name="allow_indexing" type="checkbox" /> Izinkan mesin pencari mengindeks
        undangan setelah diterbitkan</label
      >
      <p class="form-status" data-form-status role="status" aria-live="polite">
      </p>
      <button class="button" type="submit">Simpan Draft</button>
    </form>
  </section>
</AppLayout>

<script>
  function cookieValue(name: string) {
    const prefix = `${encodeURIComponent(name)}=`;
    const item = document.cookie
      .split('; ')
      .find((value) => value.startsWith(prefix));
    return item ? decodeURIComponent(item.slice(prefix.length)) : '';
  }

  const form = document.querySelector<HTMLFormElement>(
    '[data-invitation-form]',
  );
  const template = form?.querySelector<HTMLSelectElement>(
    '[name="template_key"]',
  );
  const batakFields = form?.querySelectorAll<HTMLFieldSetElement>(
    '[data-batak-fields]',
  );
  const toggleThemeFields = () => {
    const active = template?.value === 'batak-senja';
    batakFields?.forEach((fieldset) => {
      fieldset.hidden = !active;
      fieldset.disabled = !active;
    });
  };
  template?.addEventListener('change', toggleThemeFields);
  toggleThemeFields();
  let draftId: string | undefined;
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const values = new FormData(form);
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const button = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    if (!status || !button) return;

    const batak = values.get('template_key') === 'batak-senja';
    const localTime = (name: string) => {
      const value = String(values.get(name) ?? '');
      return value ? `${value}:00+07:00` : undefined;
    };
    const eventData = (prefix: string) => ({
      name: values.get(`${prefix}name`),
      start_at: localTime(`${prefix}start_at`),
      end_at: localTime(`${prefix}end_at`),
      timezone: 'Asia/Jakarta',
      venue_name: values.get(`${prefix}venue_name`),
      venue_address: values.get(`${prefix}venue_address`),
      map_url: values.get(`${prefix}map_url`) || undefined,
    });
    const designKeys = [
      'opening_heading',
      'opening_text',
      'greeting_text',
      'quote_text',
      'quote_source',
      'bride_parents',
      'groom_parents',
      'bride_instagram',
      'groom_instagram',
      'couple_note',
      'rsvp_text',
      'prayer_title',
      'prayer_text',
      'prayer_source',
      'gift_text',
      'gift_bank',
      'gift_account_name',
      'gift_account_number',
      'closing_text',
      'music_url',
    ];
    const designData = Object.fromEntries(
      designKeys
        .map((key) => [key, String(values.get(key) ?? '').trim()])
        .filter(([, value]) => value),
    );
    const portraits = [
      { kind: 'bride', file: values.get('bride_photo') },
      { kind: 'groom', file: values.get('groom_photo') },
    ];
    const gallery = [
      ...(form.querySelector<HTMLInputElement>('[name="gallery_photos"]')
        ?.files ?? []),
    ];
    if (batak && gallery.length > 5) {
      status.textContent = 'Maksimal lima foto galeri.';
      return;
    }
    const images = batak
      ? [
          ...portraits.map(({ kind, file }) => ({ kind, position: 0, file })),
          ...gallery.map((file, position) => ({
            kind: 'gallery',
            position,
            file,
          })),
        ].filter(
          (item): item is { kind: string; position: number; file: File } =>
            item.file instanceof File && item.file.size > 0,
        )
      : [];
    if (
      images.some(
        ({ file }) =>
          file.size > 5 * 1024 * 1024 ||
          !['image/jpeg', 'image/png', 'image/webp'].includes(file.type),
      )
    ) {
      status.textContent =
        'Setiap foto harus berupa JPEG, PNG, atau WebP berukuran maksimal 5 MB.';
      return;
    }
    const events = [
      eventData('event_'),
      ...(batak ? [eventData('event_two_')] : []),
    ];
    if (
      events.some(
        (item) => item.end_at && item.start_at && item.end_at <= item.start_at,
      )
    ) {
      status.textContent =
        'Waktu berakhir harus setelah waktu mulai pada setiap acara.';
      return;
    }
    const payload = {
      event_type: values.get('event_type'),
      slug: values.get('slug'),
      title: values.get('title'),
      template_key: values.get('template_key'),
      allow_indexing: values.get('allow_indexing') === 'on',
      hosts: [
        {
          name: values.get('host_one_name'),
          role: values.get('host_one_role'),
        },
        {
          name: values.get('host_two_name'),
          role: values.get('host_two_role'),
        },
      ],
      events,
      design_data: batak ? designData : {},
    };

    status.textContent = 'Menyimpan draft…';
    button.disabled = true;
    try {
      const response = await fetch(
        draftId ? `/api/v1/invitations/${draftId}` : '/api/v1/invitations',
        {
          method: draftId ? 'PATCH' : 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': cookieValue('adicara_csrf'),
          },
          body: JSON.stringify(payload),
        },
      );
      if (response.status === 401) {
        window.location.assign('/auth/masuk');
        return;
      }
      if (!response.ok) {
        const body = await response.json();
        throw new Error(body?.error?.message ?? 'Draft belum dapat disimpan.');
      }
      const saved = (await response.json()) as { id: string };
      draftId = saved.id;
      for (const [index, { kind, position, file }] of images.entries()) {
        status.textContent = `Mengunggah foto ${index + 1} dari ${images.length}…`;
        const media = new FormData();
        media.set('kind', kind);
        media.set('position', String(position));
        media.set('image', file);
        const uploaded = await fetch(`/api/v1/invitations/${draftId}/media`, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'X-CSRF-Token': cookieValue('adicara_csrf') },
          body: media,
        });
        if (!uploaded.ok) {
          const body = await uploaded.json().catch(() => null);
          throw new Error(
            `Draft tersimpan, tetapi foto ${index + 1} gagal diunggah: ${body?.error?.message ?? 'coba lagi'}.`,
          );
        }
      }
      window.location.assign('/dashboard');
    } catch (error) {
      status.textContent =
        error instanceof Error ? error.message : 'Draft belum dapat disimpan.';
      button.disabled = false;
    }
  });
</script>

<style>
  .editor-container {
    width: min(calc(100% - 2rem), 48rem);
    margin-inline: auto;
  }
  .editor-hero {
    padding-block: var(--space-7);
    background: var(--color-surface);
  }
  .editor-hero > div > a {
    display: inline-block;
    margin-bottom: var(--space-6);
    color: var(--color-text-muted);
  }
  .editor-hero h1 {
    max-width: 13ch;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
  }
  .editor-hero p:last-child {
    color: var(--color-text-muted);
  }
  .editor-section {
    padding-block: var(--space-7);
  }
  form,
  fieldset,
  label {
    display: grid;
  }
  form {
    gap: var(--space-6);
  }
  fieldset {
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  legend {
    padding-inline: var(--space-2);
    font-family: var(--font-display);
    font-size: 1.5rem;
  }
  label {
    gap: var(--space-2);
    font-size: 0.85rem;
    font-weight: 700;
  }
  input,
  select,
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-text);
  }
  textarea {
    resize: vertical;
  }
  .two-columns {
    display: grid;
    gap: var(--space-4);
  }
  .checkbox {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .checkbox input {
    width: 1.1rem;
    min-height: 1.1rem;
    margin-top: 0.25rem;
  }
  .form-status {
    margin: 0;
    color: var(--color-text-muted);
  }
  .form-status:not(:empty) {
    padding: var(--space-3);
    border-left: 2px solid var(--color-accent);
    background: var(--color-surface-muted);
  }
  .button {
    cursor: pointer;
  }
  @media (min-width: 38rem) {
    .two-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 48rem) {
    .editor-container {
      width: min(calc(100% - 4rem), 48rem);
    }
    fieldset {
      padding: var(--space-6);
    }
  }
</style>

---
import AuthForm from '@/components/auth/AuthForm.astro';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
---

<MarketingLayout
  title="Daftar — Adicara"
  description="Buat akun Adicara untuk mulai menyusun undangan digital."
  canonicalPath="/auth/daftar"
  noindex={true}
>
  <section class="auth-page">
    <div class="container auth-grid">
      <div class="auth-intro">
        <p class="eyebrow">Mulai dari sini</p>
        <h1>Susun undangan dalam langkah yang tenang.</h1>
        <p class="lede">
          Akun menyimpan undangan sebagai draft sampai kalian siap
          menerbitkannya.
        </p>
      </div>
      <div class="auth-card">
        <h2>Buat akun</h2>
        <AuthForm mode="register" />
        <p>Sudah punya akun? <a href="/auth/masuk">Masuk</a></p>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .auth-page {
    display: grid;
    min-height: 70vh;
    align-items: center;
    padding-block: var(--space-7);
  }
  .auth-grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  .auth-intro h1 {
    max-width: 12ch;
    font-size: clamp(2.75rem, 8vw, 5.2rem);
  }
  .auth-card {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }
  .auth-card h2 {
    font-size: 2.5rem;
  }
  .auth-card > p {
    margin: var(--space-5) 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  @media (min-width: 48rem) {
    .auth-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
    .auth-card {
      padding: var(--space-7);
    }
  }
</style>

---
import AuthForm from '@/components/auth/AuthForm.astro';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
---

<MarketingLayout
  title="Masuk — Adicara"
  description="Masuk ke ruang pengelolaan undangan Adicara."
  canonicalPath="/auth/masuk"
  noindex={true}
>
  <section class="auth-page">
    <div class="container auth-grid">
      <div class="auth-intro">
        <p class="eyebrow">Selamat datang kembali</p>
        <h1>Lanjutkan persiapan perayaanmu.</h1>
        <p class="lede">
          Kelola detail acara, pilih tema, dan terbitkan saat semuanya siap.
        </p>
      </div>
      <div class="auth-card">
        <h2>Masuk</h2>
        <AuthForm mode="login" />
        <p>Belum punya akun? <a href="/auth/daftar">Daftar</a></p>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .auth-page {
    display: grid;
    min-height: 70vh;
    align-items: center;
    padding-block: var(--space-7);
  }

  .auth-grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .auth-intro h1 {
    max-width: 11ch;
    font-size: clamp(2.75rem, 8vw, 5.2rem);
  }

  .auth-card {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .auth-card h2 {
    font-size: 2.5rem;
  }

  .auth-card > p {
    margin: var(--space-5) 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  @media (min-width: 48rem) {
    .auth-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .auth-card {
      padding: var(--space-7);
    }
  }
</style>
